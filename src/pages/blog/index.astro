---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "Blog";
---

<BaseLayout title={title}>
	<h1>{title} - Todo</h1>

	<h2>Landing Page</h2>
	<ul>
		<li>News</li>
		<li>Short Topics</li>
		<li>Studies</li>
		<li>Workspace Setups (Dotfiles, Windows + Linux Setups)</li>
		<li>Tutorials</li>
	</ul>

	<h2>Posts</h2>

	Sort by Date, Tags, Categories
</BaseLayout>
