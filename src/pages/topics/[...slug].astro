---
import { getCollection, type CollectionEntry } from "astro:content";
import NotReleased from "../../components/NotReleased.astro";
import Overview from "../../components/Overview.astro";
import MarkdownLayout from "../../layouts/MarkdownLayout.astro";

interface Props {
	entry: CollectionEntry<"topics">;
}

export async function getStaticPaths() {
	const topics = await getCollection("topics");
	return topics.map((entry: CollectionEntry<"topics">) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

type Heading = {
	depth: number;
	text: string;
	slug: string;
};

const { entry } = Astro.props;

const headings: Heading[] = entry.rendered?.metadata?.headings;

console.log(headings);

// set all files to release true for testing
const release = import.meta.env.DEV || entry.data.release;

const { Content } = await entry.render();
---

<MarkdownLayout title={entry.data.title} headings={headings}>
	{release ? <Content /> : <NotReleased />}
	{entry.id.includes("index") && <Overview entry={entry} />}
</MarkdownLayout>
