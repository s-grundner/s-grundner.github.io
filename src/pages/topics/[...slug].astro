---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotReleased from "../../components/NotReleased.astro";
import Overview from "../../components/Overview.astro";

interface Props {
	entry: CollectionEntry<"topics">;
}

export async function getStaticPaths() {
	const topics = await getCollection("topics");
	return topics.map((entry: CollectionEntry<"topics">) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { title } = entry.data;

// set all files to release true for testing
const release = import.meta.env.DEV || entry.data.release;

const { Content } = await entry.render();
---

<BaseLayout title={title}>
	{release ? <Content /> : <NotReleased />}
	{entry.id.includes("index") && <Overview entry={entry} />}
</BaseLayout>
