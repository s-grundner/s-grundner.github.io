---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopicCardGrid from "../../components/TopicCardGrid.astro";

// Fetch only top-level index entries
const entries = await getCollection(
	"topics",
	(entry) => entry.id.includes("index") && entry.slug.split("/").length === 1,
);
---

<BaseLayout title="Topics">
	{ entries.length > 0 &&
	<h1 class="pb-5">Themengebiete</h1>
	<TopicCardGrid entries={entries} />
	}
</BaseLayout>
