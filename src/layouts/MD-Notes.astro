---
import Layout from "../layouts/Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
	<article>
		{
			frontmatter.draft ? (
				<p>
					<em>
						Note: This article is a draft and may be incomplete or
						subject to change.
					</em>
				</p>
			) : (
				<slot />
			)
		}
	</article>
</Layout>
