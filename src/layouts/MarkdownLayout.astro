---
import Separator from "../components/Separator.astro";
import TOC from "../components/TOC.astro";
import Tags from "../components/Tags.astro";
import "../styles/callout.css";
import "../styles/markdown.css";

interface Props {
	headings: {
		depth: number;
		text: string;
		slug: string;
	}[];
	tags: string[];
}

const { headings, tags } = Astro.props;
const needsTOC = headings && headings.length > 1;
const needsTags = tags && tags.length > 0;
---

<article>
<div class="xl:flex">
	<div class="markdown-wrapper xl:shrink"><slot /></div>
	<div class="hidden xl:inline xl:flex-none">
	{
		(needsTOC || needsTags) && (
			<div class="sidebar">
				{needsTOC && <TOC headings={headings} />}
				{needsTOC && needsTags && <Separator />}
				{needsTags && <Tags tags={tags} />}
			</div>
		)
	}
	</div>
</div>
</article>
