---
import TOC from "../components/TOC.astro";
import "../styles/callout.css";

interface Props {
	headings: {
		depth: number;
		text: string;
		slug: string;
	}[];
}
const { headings } = Astro.props;
---

<article>
	{headings && headings.length > 0 && <TOC headings={headings} />}
	<div class="markdown-wrapper"><slot /></div>
</article>
