---
import { getCollection, type CollectionEntry } from "astro:content";
import Files from "./Files.astro";
import TopicCardGrid from "./TopicCardGrid.astro";

interface Props {
	entry: CollectionEntry<"topics">;
}
const { entry } = Astro.props;

const cwd = entry.slug;

const currentEntries = await getCollection(
	"topics",
	(e) => e.id !== entry.id && e.slug.startsWith(cwd),
);

const idxEntries = currentEntries.filter((e) => e.id.includes("index"));

const fileEntries = currentEntries
	.filter((e) => !e.id.includes("index"))
	.filter((e) => e.data.title !== "Untitled");
---

{idxEntries.length > 0 && 
<h2>Themengebiete</h2>
<TopicCardGrid entries={idxEntries} />
}
{fileEntries.length > 0 && 
<h2>Einträge</h2>
<Files entries={fileEntries} />
}