---
const searchPlaceHolder = "Search...";
---

<div class="search-container relative">
	<input
		id="search-input"
		type="text"
		placeholder={searchPlaceHolder}
		class="w-full px-4 py-2 border bg-ctp-mantle border-ctp-surface1 rounded-lg focus:outline-none focus:ring-2 focus:ring-ctp-flamingo"
	/>
	<ul
		id="search-results"
		class="absolute z-10 w-full mt-2 bg-ctp-base border border-ctp-flamingo rounded-lg shadow-lg hidden max-h-60 overflow-y-auto"
	>
	</ul>
</div>

<style>
	input:-webkit-autofill,
	input:-webkit-autofill:focus,
	input:-webkit-autofill:hover,
	input:-webkit-autofill:active {
		-webkit-box-shadow: 0 0 0 1000px bg-ctp-mantle inset !important;
		-webkit-text-fill-color: text-ctp-text !important;
		caret-color: var(--color-ctp-text);
		border-radius: inherit;
	}
</style>

<script>
	type SearchItem = {
		pathname?: string;
		url?: string;
		frontmatter?: {
			title?: string;
			aliases?: string[] | string;
		};
	};

	// aliases could be a string or a string[].
	// convert to array for .join()
	const toArray = <T,>(value: T | T[] | undefined | null): T[] =>
		Array.isArray(value) ? value : value != null ? [value] : [];
	
	const searchInput = document.getElementById(
		"search-input",
	) as HTMLInputElement;
	const searchResults = document.getElementById("search-results");

	let fuse: any;

	async function initSearch() {
		console.log("Initializing search...");
		// Dynamic import to avoid bundling Fuse.js in the initial chunk if possible,
		// though strictly Astro might bundle it anyway.
		// But it's good practice for large libraries.
		const Fuse = (await import("fuse.js")).default;

		try {
			const response = await fetch("/fuse.json");
			if (!response.ok) {
				throw new Error(
					`Failed to fetch index: ${response.statusText}`,
				);
			}
			const data = await response.json();

			const options = {
				keys: [
					"frontmatter.title",
					"content",
					"frontmatter.aliases",
					"frontmatter.description",
				],
				includeScore: true,
				threshold: 0.4,
				ignoreLocation: true, // Search through all content
			};

			// Initialize Fuse with the list from our custom endpoint
			fuse = new Fuse(data.list, options);
			console.log("Fuse initialized with", data.list.length, "items");
		} catch (error) {
			console.error("Error initializing search:", error);
		}
	}

	// Load index on interaction to save bandwidth
	searchInput?.addEventListener("focus", initSearch, { once: true });

	searchInput?.addEventListener("input", () => {
		if (!fuse) {
			return;
		}

		const query = searchInput.value;
		console.log("Searching for:", query);
		const results = fuse.search(query);
		// console.log("Results:", results);

		if (searchResults) {
			searchResults.innerHTML = "";

			if (results.length > 0) {
				searchResults.classList.remove("hidden");
				results
					.slice(0, 10)
					.forEach(({ item }: { item: SearchItem }) => {
						console.log(item);

						const li = document.createElement("li");
						li.className =
							"px-4 py-2 hover:bg-ctp-mantle cursor-pointer";

						const a = document.createElement("a");
						a.href = item.pathname || item.url || "";
						a.className = "block";

						const title = document.createElement("div");
						title.className = "font-bold text-ctp-text1";
						title.textContent =
							item.frontmatter?.title ?? "Untitled";

						const aliases = document.createElement("div");
						aliases.className =
							"text-sm text-ctp-subtext1 truncate";
						aliases.textContent = toArray(item.frontmatter?.aliases).join(", ");

						a.append(title, aliases);
						li.appendChild(a);

						searchResults.appendChild(li);
					});
			} else {
				searchResults.classList.add("hidden");
			}
		}
	});

	// Hide results when clicking outside
	document.addEventListener("click", (e) => {
		if (
			!searchInput?.contains(e.target as Node) &&
			!searchResults?.contains(e.target as Node)
		) {
			searchResults?.classList.add("hidden");
		}
	});
</script>
