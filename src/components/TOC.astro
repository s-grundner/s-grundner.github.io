---
interface Props {
	headings: {
		depth: number;
		text: string;
		slug: string;
	}[];
}
const { headings } = Astro.props;
---

{
	(
		<nav>
			<h3 class="text-2xl">Inhalt</h3>
			<ul>
				{headings
					.filter((h) => h.depth > 1)
					.map((heading) => (
						<li class={`toc-item depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))}
			</ul>
		</nav>
	)
}
