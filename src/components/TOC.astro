---
interface Props {
	headings: {
		depth: number;
		text: string;
		slug: string;
	}[];
}
const { headings } = Astro.props;
---

{
	(
		<nav class="article-toc">
			<h3 class="text-2xl">Inhalt</h3>
			<ul>
				{headings.map((heading) => (
					<li class={`toc-item depth-${heading.depth}`}>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))}
			</ul>
		</nav>
	)
}
