---
import BurgerMenu from "./BurgerMenu.astro";
import Tabs from "./Navigation.astro";
import LogoMenu from "./LogoMenu.astro";
---

<header>
	<nav class="my-auto">
		<div class="md:hidden grid grid-cols-2 justify-stretch">
			<div class="mr-auto"> <LogoMenu /> </div>
			<div class="ml-auto"> <BurgerMenu /> </div>
		</div>
		<div class="hidden md:inline text-center">
			<div class="flex justify-around"> <Tabs /> </div>
		</div>
	</nav>
</header>
